# invest-monitor - environment configuration (Docker Compose reads this file automatically).
#
# Copy this file to .env and fill in what you need, then re-create the containers (not just restart -
# environment changes only take effect on `docker compose up -d --force-recreate`, or plain `restart` for
# Nginx-only changes). Everything below except "数据目录/绑定/代理" (data dir, bind address, proxies) can
# also be left blank here and configured later from the web UI's 账号设置 (Settings) page instead, where
# it is stored encrypted in the local database; the two are interchangeable, and Settings overrides an
# .env value while it is set. Values here never reach the browser (no VITE_ variables are used for
# secrets).

########################################
# 数据目录 / 绑定地址 (Docker Compose only)
########################################

# Host directory that holds the database, market history, logs and backups; subdirectories db/,
# market-archive/, logs/, backups/ are created under it. Must already exist and be writable.
INVEST_DATA_DIR=./data

# Address/port Nginx (the web container) publishes on the host. 0.0.0.0 exposes it on every interface;
# use a specific host/VPN IP to restrict it.
UI_BIND_IP=0.0.0.0
UI_PORT=8080

# Public URL end users reach this deployment at, e.g. https://invest.example.com. Only used as the
# origin in the example commands of GET /api/settings/schema; defaults to the request's own Host header.
UI_PUBLIC_URL=

########################################
# 登录 / 会话
########################################

# Set to true only when the API is served over HTTPS (a TLS-terminating proxy in front of Nginx); the
# session cookie is otherwise rejected by browsers.
UI_AUTH_COOKIE_SECURE=false
# Session lifetime in seconds. Default 43200 = 12 hours.
UI_AUTH_SESSION_TTL_SECONDS=43200

########################################
# 网络出口代理 (为空 = 直连)
########################################

# HTTP(S) proxy for market-data/news/broker egress from inside the containers and for the Docker build
# step (apt/npm). Point at the Docker host, not loopback: e.g. http://host.docker.internal:17890. Leave
# empty to connect directly - most deployments do not need this.
DOCKER_EGRESS_PROXY_URL=
DOCKER_BUILD_PROXY_URL=

# Broker sync (Tradier/IBKR/Schwab/Alpaca) proxy, independent of DOCKER_EGRESS_PROXY_URL above and of the
# market-data egressProfiles in config/portfolio.yaml. Also settable from Settings -> 网络出口.
BROKER_EGRESS_PROXY_URL=

# Market-data / news egress (Tradier quotes, gold spot, crypto, RSS news such as coindesk). The example
# config connects directly (egressProfiles.*.proxyUrl = null). If direct DNS/HTTPS to those sites is blocked
# on your machine (typical symptom: "getaddrinfo ENOTFOUND www.coindesk.com" in the source log, the
# breaker stays "closed" and retries later), set ONE proxy for every profile here instead of editing the
# YAML. Source/portable mode only (.env next to the app): under Docker, DOCKER_EGRESS_PROXY_URL above is
# passed into the container as EGRESS_SINGLE_PROXY_URL and BROKER_EGRESS_PROXY_URL.
# 行情/新闻出口代理：示例配置默认直连；若本机无法解析或访问这些站点，填一个代理即可让所有出口配置走代理
# （源码/便携模式用本变量；Docker 用上面的 DOCKER_EGRESS_PROXY_URL）。
EGRESS_SINGLE_PROXY_URL=
# Or override a single profile only (direct / corp / vpn from config/portfolio.yaml); empty = keep the YAML
# value. Not mapped by docker-compose — source/portable mode only.
EGRESS_DIRECT_PROXY_URL=
EGRESS_CORP_PROXY_URL=
EGRESS_VPN_PROXY_URL=

########################################
# 账号设置加密 / 只读
########################################

# Encrypts broker/LLM secrets saved from the Settings page at rest. A 64-character hex string is used
# as-is; any other non-empty string is hashed into a key. Leave empty to auto-generate and store a key
# file next to the database instead (back it up together with the database). Changing this value makes
# previously saved Settings secrets unreadable until re-entered.
SETTINGS_ENCRYPTION_KEY=

# true makes the Settings page/API read-only (existing values still apply; nothing can be added, changed
# or tested from the UI). Useful when every secret here is managed entirely through .env instead.
SETTINGS_READONLY=false

########################################
# 券商只读同步
########################################

# Tradier: shared by stock/ETF/option quotes, search, daily history AND read-only account sync. A
# production token for live data, or a sandbox/paper token for 15-minute-delayed data.
TRADIER_ACCESS_TOKEN=
TRADIER_ENVIRONMENT=live

# IBKR (盈透): Flex Web Service, read-only positions + trades report.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# Schwab (嘉信): Trader API, OAuth 2.0. SCHWAB_REDIRECT_URI must exactly match the callback URL
# registered in the Schwab developer portal. SCHWAB_REFRESH_TOKEN is normally written automatically by
# the "授权" (Authorize) flow on the Settings page, not typed in here; it expires after 7 days.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1
SCHWAB_REFRESH_TOKEN=

# Alpaca: Trading API key (read-only scope is sufficient).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_ENVIRONMENT=live

########################################
# 市场日报推理 LLM (手动触发，默认不调用)
########################################

# openai-compatible/deepseek send Chat Completions + max_tokens; openai sends max_completion_tokens.
# DAILY_LLM_BASE_URL includes the API version path and nothing else, e.g. https://api.deepseek.com/v1 or
# https://api.openai.com/v1 (no /chat/completions, no query string).
DAILY_LLM_PROVIDER=openai-compatible
DAILY_LLM_BASE_URL=
DAILY_LLM_API_KEY=
DAILY_LLM_MODEL=
DAILY_LLM_TIMEOUT_MS=180000
DAILY_LLM_MAX_OUTPUT_TOKENS=0
# auto compares authenticated /models reads over true-direct and VPN egress and picks the working, faster
# route (cached); direct/vpn/corp pin one route instead.
DAILY_LLM_EGRESS_PROFILE=auto
# Trading review: after a broker sync, ask the same LLM for SOP-based merge suggestions when unresolved
# multi-leg groupings changed (at most once per 30 minutes). Set 0 to run it only from the page.
REVIEW_MERGE_ADVICE_AUTO=1

########################################
# 可选 / 历史遗留
########################################

# Optional legacy quote provider, disabled by default. Tradier is the active stock/ETF/option source.
MASSIVE_API_KEY=

# Optional news-summary LLM provider (separate from the daily-report LLM above); also requires enabling
# the provider and setting a real model in config/portfolio.yaml before it is used.
OPENROUTER_API_KEY=
